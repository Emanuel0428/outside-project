{
    "routes": [
      {
        "src": "/assets/(.*)",
        "dest": "/assets/$1",
        "headers": {
          "cache-control": "public, max-age=31536000, immutable"
        }
      },
      {
        "src": "/index.html",
        "dest": "/index.html",
        "headers": {
          "cache-control": "public, max-age=0, must-revalidate"
        }
      },
      {
        "src": "/(.*)",
        "dest": "/index.html",
        "status": 200,
        "continue": true
      },
      {
        "src": "/(.*)",
        "status": 404,
        "dest": "/index.html"
      }
    ]
  }